# Скопируйте в .env для локального запуска. Файл .env в git не коммитим!
BOT_TOKEN=123456:ABC-токен-от-BotFather
# Telegram ID администратора (узнать: бот @userinfobot); если несколько — используется первый
ADMIN_IDS=111111111
# Локально — файл рядом с ботом. Docker-образ Amvera по умолчанию использует /data/zoobot.db.
DB_PATH=zoobot.db
POLICY_URL=
TIMEZONE=Europe/Moscow
WEBAPP_URL=
BOT_USERNAME=zooconcierge_bot
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Дополнительные настройки задавайте в переменных проекта Amvera, а не в git.
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_CONTACT=
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
RESEND_API_KEY=
RESEND_FROM=
ADMIN_PHONE=
PAY_SBP_PHONE=
PAY_SBP_BANK=
PAY_CARD=
PAY_RECIPIENT=
SITE_LEADS_KEY=
