# Скопируйте в .env и заполните. Файл .env в git не коммитим!
BOT_TOKEN=123456:ABC-токен-от-BotFather
# Telegram ID админов через запятую (узнать: бот @userinfobot)
ADMIN_IDS=111111111
# Локально — файл рядом с ботом. На Amvera постоянный диск смонтирован в /data.
DB_PATH=zoobot.db
POLICY_URL=https://example.com/privacy
TIMEZONE=Europe/Moscow
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Вход администратора по почте. Секреты задаются только в переменных Amvera, не в git.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
