# Пример переменных для российского размещения «Зооконсьерж».
# Реальные значения задавайте в защищённом разделе Variables / Secrets хостинга.
# Не отправляйте токены и пароли в чат и не коммитьте их в Git.

# Обязательные
BOT_TOKEN=
ADMIN_IDS=
DB_PATH=/data/zoobot.db
# Для временного теста можно использовать бесплатный домен Amvera; для production после выбора адреса заменить на финальный HTTPS-домен.
WEBAPP_URL=https://your-project-your-login.msk0.amvera.tech
TIMEZONE=Europe/Moscow
BOT_USERNAME=zooconcierge_bot

# Публичная политика и данные оператора
POLICY_URL=
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_CONTACT=

# Подтверждение телефона через Яндекс ID (необязательно)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Администратор и вход в портал
ADMIN_EMAIL=
ADMIN_PHONE=

# Почта: выберите один способ отправки.
# Вариант A — Resend по HTTPS
RESEND_API_KEY=
RESEND_FROM=
# Вариант B — SMTP (используется, если RESEND_API_KEY не задан)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Реквизиты для ручной оплаты (если включены в работе)
PAY_SBP_PHONE=
PAY_SBP_BANK=
PAY_CARD=
PAY_RECIPIENT=

# Приём заявок от внешнего сайта/конструктора и пересылка в «Мой помощник»
SITE_LEADS_KEY=
HELPER_NOTIFY_URL=

# Подтверждение сайта в поисковых системах (необязательно)
YANDEX_VERIFICATION=
GOOGLE_VERIFICATION=
BING_VERIFICATION=
