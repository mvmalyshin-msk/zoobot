# ============================================
# Telegram-бот: настройка переменных окружения
# ============================================

# 1) Токен от BotFather (обязательно)
BOT_TOKEN=

# 2) ID пользователей, кому разрешено писать боту
# Узнайте свой ID: напишите боту /id, затем впишите сюда
ALLOWED_USER_IDS=

# 3) Проводники ИИ (нужен хотя бы один)
# ------------------------------------------
# SberGPT — бесплатно, без карты (рекомендуется)
# Получить: cloud.sber.ru → Сервисы → SberGPT → API-ключ
SBERSDK_API_KEY=

# Groq — бесплатный тариф
# Получить: console.groq.com → API Keys
GROQ_API_KEY=

# Gemini — бесплатный тариф
# Получить: aistudio.google.com
GEMINI_API_KEY=

# OpenRouter — бесплатный тариф
# Получить: openrouter.ai → API Keys
OPENROUTER_API_KEY=

# 4) Часовой пояс (по умолчанию Москва)
TIMEZONE=Europe/Moscow

# 5) Путь к базе данных (по умолчанию bot.db)
DB_PATH=bot.db

# 6) Публичный адрес сайта (для пуш-уведомлений и ссылок)
WEBAPP_URL=https://your-domain.onrender.com
